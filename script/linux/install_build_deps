#!/usr/bin/env bash
#
# Install all dependencies required to build Warp on Linux.

set -e

. "$PWD/script/warp_sudo"
. "$PWD/script/linux/package_manager"

# Install some development libraries that will be needed in the compilation
# process.
echo "⬇️  Installing build-time dependencies..."
case "$(linux_distro_family)" in
  debian)
    PACKAGES=(
      curl git unzip
      build-essential cmake pkg-config
      python-is-python3
      libssl-dev libfreetype-dev libexpat1-dev libgit2-dev
      libfontconfig1-dev
      jq brotli
      libasound2-dev
      libclang-dev clang-format
      musl-tools
    )
    warp_sudo apt-get install -y "${PACKAGES[@]}"
    ;;
  fedora)
    PACKAGES=(
      curl git unzip
      gcc gcc-c++ make cmake pkgconf-pkg-config
      python-unversioned-command
      openssl-devel freetype-devel expat-devel libgit2-devel
      fontconfig-devel
      jq brotli
      alsa-lib-devel
      clang-devel clang-tools-extra
      musl-gcc
    )
    warp_sudo dnf install -y "${PACKAGES[@]}"
    ;;
  *)
    echo "error: unsupported Linux distribution; build dependencies were not installed." >&2
    exit 1
    ;;
esac

# Install a modern version of protoc. Some supported distributions ship a version that is too
# old for proto3 optional fields, which require protoc >= 3.15.
PROTOC_VERSION="25.1"
case "$(uname -m)" in
  x86_64)  PROTOC_ZIP="protoc-${PROTOC_VERSION}-linux-x86_64.zip" ;;
  aarch64) PROTOC_ZIP="protoc-${PROTOC_VERSION}-linux-aarch_64.zip" ;;
  *)       echo "Unsupported architecture for protoc: $(uname -m)"; exit 1 ;;
esac
curl -fsSL -o /tmp/protoc.zip \
  "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/${PROTOC_ZIP}"
warp_sudo unzip -o /tmp/protoc.zip -d /usr/local bin/protoc 'include/*'
rm /tmp/protoc.zip

# Install Rust.
"$PWD"/script/install_rust

# Install various build-time dependencies through cargo.
"$PWD"/script/install_cargo_build_deps
