#!/usr/bin/env bash
#
# Install all dependencies required to build and run Warp on Linux.

set -e

. "$PWD/script/warp_sudo"
. "$PWD/script/linux/package_manager"

# Install build dependencies.
"$PWD"/script/linux/install_build_deps

# Install additional runtime dependencies.
echo "⬇️  Installing runtime dependencies..."
case "$(linux_distro_family)" in
  debian)
    PACKAGES=(
      locales fontconfig zlib1g
      libx11-6 libxcb1 libxi6 libxcursor1 libxkbcommon-x11-0
      libwayland-client0 libwayland-egl1
      mesa-vulkan-drivers libegl1 yaru-theme-icon
    )
    warp_sudo apt-get install -y "${PACKAGES[@]}"
    ;;
  fedora)
    PACKAGES=(
      glibc-langpack-en fontconfig zlib-ng-compat
      libX11 libxcb libXi libXcursor libxkbcommon-x11
      libwayland-client libwayland-egl
      mesa-vulkan-drivers libglvnd-egl adwaita-cursor-theme fuse-libs
    )
    warp_sudo dnf install -y "${PACKAGES[@]}"
    ;;
  *)
    echo "error: unsupported Linux distribution; runtime dependencies were not installed." >&2
    exit 1
    ;;
esac
